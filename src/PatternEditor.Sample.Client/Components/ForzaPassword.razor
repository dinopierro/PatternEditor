@namespace PatternEditor.Sample.Client.Components
@implements IDisposable
@inject Lingua T

@*
   Quanto è lunga la strada verso una password accettabile.

   Non è un "misuratore di robustezza" con la freccia che sale: quelli promettono una
   valutazione che il browser non è in grado di dare — «Estate2024!» segna verde ovunque ed è
   fra le prime mille che si provano. Questo dice una cosa sola e la dice esatta: quanti
   caratteri mancano alla soglia che il server accetta.

   La regola vera sta sul server. Questa è solo la stessa regola detta prima, per non far
   scoprire da un errore quello che si poteva sapere scrivendo.
*@
@if (!string.IsNullOrEmpty(Password))
{
    <div class="forza @(Stato)">
        <div class="forza__barra">
            <span style="width: @(Percentuale)%"></span>
        </div>
        <p class="forza__testo">@Messaggio</p>
    </div>
}

@code {
    private const int Minimo = 12;

    [Parameter]
    public string? Password { get; set; }

    /// <summary>Il nome utente, che nella password non può comparire.</summary>
    [Parameter]
    public string? Utente { get; set; }

    private int Lunghezza => Password?.Length ?? 0;

    private int Percentuale => Math.Min(100, Lunghezza * 100 / Minimo);

    private bool ContieneIlNome =>
        !string.IsNullOrWhiteSpace(Utente)
        && Utente.Length >= 3
        && (Password ?? string.Empty).Contains(Utente, StringComparison.OrdinalIgnoreCase);

    private int CaratteriDistinti
    {
        get
        {
            var visti = new HashSet<char>();
            foreach (var c in Password ?? string.Empty)
            {
                visti.Add(c);
            }

            return visti.Count;
        }
    }

    private bool Bene => Lunghezza >= Minimo && !ContieneIlNome && CaratteriDistinti >= 5;

    private string Stato => Bene ? "is-buona" : Lunghezza >= Minimo ? "is-media" : "is-corta";

    private string Messaggio
    {
        get
        {
            if (ContieneIlNome)
            {
                return T["forza.contieneNome"];
            }

            if (Lunghezza < Minimo)
            {
                var mancano = Minimo - Lunghezza;
                return mancano == 1
                    ? T["forza.mancaUno"]
                    : T["forza.mancano", mancano];
            }

            return CaratteriDistinti < 5
                ? T["forza.pocaVarieta"]
                : T["forza.vaBene"];
        }
    }

    protected override void OnInitialized() => T.Cambiata += Ridisegna;

    private void Ridisegna() => InvokeAsync(StateHasChanged);

    public void Dispose() => T.Cambiata -= Ridisegna;
}
