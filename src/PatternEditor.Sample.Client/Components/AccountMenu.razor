@namespace PatternEditor.Sample.Client.Components
@implements IDisposable
@inject AuthClient Auth
@inject Lingua T

@*
   L'angolo dell'utente, in alto a destra: un pulsante per entrare, oppure il cerchio con il
   nome e il menù che ne discende.

   Le finestre di accesso e di profilo vivono qui e non nella pagina: appartengono
   all'intestazione, che è sempre a schermo, e metterle nella pagina significherebbe
   ricrearle in ognuna.
*@
@if (!Auth.Pronto)
{
    @* Finché non si sa, non si dice. Mostrare «Accedi» e poi sostituirlo con l'avatar un
       attimo dopo fa sembrare che la sessione sia stata persa e poi ritrovata. *@
    <span class="app-utente__attesa" aria-hidden="true"></span>
}
else if (Auth.Utente is { } utente)
{
    <div class="app-utente">
        <button type="button" class="app-utente__bottone" @onclick="ApriMenu"
                aria-haspopup="true" aria-expanded="@(_menuAperto ? "true" : "false")"
                title="@T["app.account.profilo"]">
            <Avatar Account="utente" Lato="30" />
            <span class="app-utente__nome">@utente.Username</span>
            <span class="app-utente__freccia" aria-hidden="true">@(_menuAperto ? "▴" : "▾")</span>
        </button>

        @if (_menuAperto)
        {
            @* Superficie trasparente a tutto schermo: un clic fuori chiude il menù, senza
               gestori globali in JavaScript. *@
            <div class="app-utente__fondo" @onclick="ChiudiMenu"></div>

            <div class="app-utente__menu" role="menu">
                <button type="button" class="app-utente__voce" role="menuitem" @onclick="ApriProfilo">
                    @T["app.account.modificaProfilo"]
                </button>
                <button type="button" class="app-utente__voce app-utente__voce--esci" role="menuitem"
                        @onclick="EsciAsync">
                    @T["app.account.esci"]
                </button>
            </div>
        }
    </div>
}
else
{
    <button type="button" class="app-btn app-btn--primary app-utente__accedi" @onclick="Auth.ChiediAccesso">
        @T["app.account.accedi"]
    </button>
}

@code {
    private bool _menuAperto;

    protected override void OnInitialized()
    {
        Auth.Cambiato += Ridisegna;
        T.Cambiata += Ridisegna;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // La sessione si riprende dopo il primo rendering: prima di allora il runtime
            // JavaScript non c'è, e l'archivio del browser non si può leggere.
            await Auth.InizializzaAsync();
        }
    }

    private void ApriMenu() => _menuAperto = !_menuAperto;

    private void ChiudiMenu() => _menuAperto = false;

    private void ApriProfilo()
    {
        _menuAperto = false;
        Auth.ChiediProfilo();
    }

    private async Task EsciAsync()
    {
        _menuAperto = false;
        await Auth.EsciAsync();
    }

    private void Ridisegna() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.Cambiato -= Ridisegna;
        T.Cambiata -= Ridisegna;
    }
}
