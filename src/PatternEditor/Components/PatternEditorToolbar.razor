@namespace PatternEditor.Components
@using global::PatternEditor.Core.Models
@inject TestiEditor E

@* Barra superiore: identità del pattern a sinistra, azioni della sessione a destra.
   Le informazioni tecniche (identificativo e date) stanno in fondo alla finestra, con lo
   stato delle modifiche: sono dati di servizio, non comandi. *@
<div class="pe-toolbar-top">

    <label class="pe-field pe-field--name">
        <span class="pe-field__label">@E["editor.nomePattern"]</span>
        <input class="pe-input pe-input--name" type="text" placeholder="@E["editor.senzaNome"]"
               value="@Pattern.Name"
               @oninput="OnNameInput" />
    </label>

    @* La cronologia sta a sé, separata dalle azioni della sessione: «Annulla» qui accanto
       significa già «chiudi senza salvare», e due comandi con lo stesso nome a un centimetro
       di distanza sarebbero una trappola. Questi due portano il simbolo e dicono il resto
       nel suggerimento.

       Le frecce sono disegnate e non prese dai caratteri: ↶ e ↷ sono glifi sottili, resi
       diversamente da ogni carattere di sistema, e sulla barra che galleggia sopra il
       disegno — dove il fondo è un pattern qualunque — sparivano. Un tracciato di due pixel
       si vede allo stesso modo ovunque. *@
    <div class="pe-storia" role="group" aria-label="@E["editor.cronologia"]">
        <button type="button" class="pe-storia__btn"
                disabled="@(!PuoAnnullare)"
                title="@E["editor.annullaModificaTasti"]"
                aria-label="@E["editor.annullaModifica"]"
                @onclick="OnUndo">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                 stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true" focusable="false">
                <path d="M8 5 4 9l4 4" />
                <path d="M4 9h9a5 5 0 0 1 0 10h-4" />
            </svg>
        </button>
        <button type="button" class="pe-storia__btn"
                disabled="@(!PuoRipetere)"
                title="@E["editor.ripetiModificaTasti"]"
                aria-label="@E["editor.ripetiModifica"]"
                @onclick="OnRedo">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                 stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true" focusable="false">
                <path d="M16 5l4 4-4 4" />
                <path d="M20 9h-9a5 5 0 0 0 0 10h4" />
            </svg>
        </button>
    </div>

    <div class="pe-toolbar-top__actions">
        @if (ReadOnly)
        {
            @* In sola lettura non esistono due strade: non c'è niente da confermare e niente
               da annullare, perché niente sarebbe stato salvato comunque. Un pulsante solo,
               e il verbo è quello che descrive ciò che accade davvero. *@
            <button type="button" class="pe-btn pe-btn--secondary" @onclick="OnCancel">@E["editor.chiudi"]</button>
        }
        else
        {
            <button type="button" class="pe-btn pe-btn--secondary" @onclick="OnCancel">@E["editor.annulla"]</button>
            <button type="button" class="pe-btn pe-btn--primary" @onclick="OnConfirm">@* Su schermo stretto resta il solo verbo: "Chiudi / " non aggiunge nulla e manderebbe i pulsanti a capo. *@<span class="pe-solo-largo">@E["editor.chiudiE"]</span>@E["editor.conferma"]</button>
        }
    </div>

</div>

@code {
    /// <summary>
    /// Il pattern in lavorazione. È la copia interna dell'editor, non l'istanza dell'ospite:
    /// scrivere il nome qui non tocca nulla finché non si conferma.
    /// </summary>
    [Parameter, EditorRequired]
    public Pattern Pattern { get; set; } = default!;

    /// <summary>Notifica all'editor che il modello è stato modificato (nome del pattern).</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>
    /// L'editor è aperto ma non potrà salvare: al posto di «Annulla» e «Conferma» resta un
    /// solo «Chiudi».
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>C'è almeno una modifica da annullare.</summary>
    [Parameter]
    public bool PuoAnnullare { get; set; }

    /// <summary>C'è almeno una modifica annullata da rifare.</summary>
    [Parameter]
    public bool PuoRipetere { get; set; }

    /// <summary>Richiesta di annullare l'ultima modifica.</summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>Richiesta di rifare l'ultima modifica annullata.</summary>
    [Parameter]
    public EventCallback OnRedo { get; set; }

    /// <summary>
    /// Richiesta di conferma. Non chiude nulla di per sé: la conferma può fallire per dati
    /// non validi, e in quel caso l'editor resta aperto mostrando cosa correggere.
    /// </summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Richiesta di annullamento. Non trasporta informazioni: chi annulla deve ritrovare il
    /// proprio pattern esattamente com'era, e il modo più sicuro per garantirlo è non
    /// restituire niente.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Il nome si aggiorna a ogni battuta e non alla perdita del fuoco: lo stato «modifiche
    /// non salvate» deve accendersi appena si tocca qualcosa, non con mezzo minuto di ritardo.
    /// </summary>
    private void OnNameInput(ChangeEventArgs e)
    {
        Pattern.Name = e.Value?.ToString() ?? string.Empty;
        OnChanged.InvokeAsync();
    }
}
