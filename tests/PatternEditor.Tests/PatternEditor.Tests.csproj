<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    L'elenco dei plugin e gli attrezzi che ne popolano e confrontano le proprietà sono
    condivisi con i test dei contratti, come SORGENTE COLLEGATO e non come copia.

    Una seconda copia dell'elenco è il modo più rapido per ritrovarsi, fra sei mesi, un
    progetto di test che verifica nove tipi e un altro che ne verifica otto senza che
    nessuno dei due fallisca. Collegando il file, il decimo elemento si aggiunge in un
    punto solo e tutti i test lo vedono.
  -->
  <ItemGroup>
    <Compile Include="..\PatternEditor.Abstractions.Tests\AllPlugins.cs" Link="AllPlugins.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PatternEditor\PatternEditor.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Rect\PatternEditor.Element.Rect.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Line\PatternEditor.Element.Line.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Circle\PatternEditor.Element.Circle.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Ellipse\PatternEditor.Element.Ellipse.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Path\PatternEditor.Element.Path.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Polygon\PatternEditor.Element.Polygon.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Polyline\PatternEditor.Element.Polyline.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Text\PatternEditor.Element.Text.csproj" />
    <ProjectReference Include="..\..\plugins\PatternEditor.Element.Image\PatternEditor.Element.Image.csproj" />
  </ItemGroup>

</Project>
